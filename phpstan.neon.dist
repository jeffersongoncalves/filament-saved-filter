includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
        - tests/Fixtures
    excludePaths:
        # A page without HasTabs or a resource: the trait only reaches those behind runtime checks PHPStan can't follow.
        - tests/Fixtures/PostsReport.php
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: false
